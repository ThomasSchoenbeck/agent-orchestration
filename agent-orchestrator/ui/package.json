{
  "name": "agent-orchestrator-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --reporter=verbose src/__tests__/integration.test.js",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:update-fixture": "cross-env PLAYWRIGHT_UPDATE_FIXTURE=1 playwright test tests/e2e/_crawler"
  },
  "dependencies": {
    "dompurify": "3.4.3",
    "marked": "18.0.3",
    "svelte": "5.55.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "autoprefixer": "10.5.0",
    "cross-env": "^7.0.3",
    "jsdom": "29.1.1",
    "svelte-check": "^4.4.8",
    "tailwindcss": "4.3.0",
    "vite": "8.0.12",
    "vitest": "4.1.6"
  }
}
